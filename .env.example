# Network and server
PORT=3000
ALLOWED_ORIGIN=chrome-extension://YOUR_EXTENSION_ID
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# All real inference stays on this machine through Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=llama3.2-vision
OLLAMA_ACT_MODEL=qwen2.5:3b
MODEL_TIMEOUT_MS=30000
